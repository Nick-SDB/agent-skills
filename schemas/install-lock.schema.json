{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Nick-SDB/agent-skills/master/schemas/install-lock.schema.json",
  "additionalProperties": false,
  "properties": {
    "$schema": {"const": "https://raw.githubusercontent.com/Nick-SDB/agent-skills/master/schemas/install-lock.schema.json"},
    "adapter_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "format_version": {"const": 1},
    "mode": {"enum": ["copy", "symlink"]},
    "registry_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "rendered_files": {
      "additionalProperties": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
      "type": "object"
    },
    "skills": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "files": {
            "additionalProperties": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
            "type": "object"
          },
          "link_target": {"type": ["string", "null"]},
          "source": {"pattern": "^skills/[a-z0-9-]+/[a-z0-9-]+$", "type": "string"},
          "version": {"pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "type": "string"}
        },
        "required": ["files", "link_target", "source", "version"],
        "type": "object"
      },
      "type": "object"
    },
    "target": {"enum": ["claude-code", "codex", "kimi"]}
  },
  "required": [
    "$schema",
    "adapter_sha256",
    "format_version",
    "mode",
    "registry_sha256",
    "rendered_files",
    "skills",
    "target"
  ],
  "title": "Managed agent-skills installation lock",
  "type": "object"
}
